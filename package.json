{
  "name": "product-reviews-platform",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit && turbo run test:integration --concurrency=1",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @reviews/web test:e2e",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.dev.yml down -v",
    "infra:check": "./scripts/check-infra.sh",
    "compose:up": "docker compose up -d --wait",
    "compose:down": "docker compose down -v",
    "smoke": "./scripts/smoke.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
