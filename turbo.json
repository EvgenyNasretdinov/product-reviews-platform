{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": { "cache": false, "outputs": [] },
    "build": { "dependsOn": ["^build", "@reviews/db#generate"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test:unit": { "dependsOn": ["^build", "@reviews/db#generate"] },
    "test:integration": { "dependsOn": ["^build", "@reviews/db#generate"], "cache": false },
    "@reviews/worker#test:integration": {
      "dependsOn": ["^build", "@reviews/db#generate", "@reviews/api#build"],
      "cache": false
    },
    "test": { "dependsOn": ["test:unit", "test:integration"] }
  }
}
