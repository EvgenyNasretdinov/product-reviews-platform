{
  "name": "@reviews/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -b",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "pretest:unit": "prisma generate",
    "test:unit": "vitest run --passWithNoTests --exclude test/schema.integration.test.ts",
    "pretest:integration": "prisma generate",
    "test:integration": "vitest run test/schema.integration.test.ts",
    "test": "vitest run test/schema.integration.test.ts",
    "predb:migrate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "predb:seed": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "@reviews/tooling": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
