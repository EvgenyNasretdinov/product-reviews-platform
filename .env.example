# Configuration for running the three processes on the host (see the
# Development section of the README). `docker compose up` does NOT read this
# file — docker-compose.yml carries its own values literally — so editing it
# has no effect on the containerised stack.
DATABASE_URL=postgresql://reviews:reviews@localhost:5432/reviews?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=dev-only-secret-change-me-in-prod
JWT_EXPIRES_IN=12h
API_PORT=3001
REVIEW_SUBMIT_RATE_LIMIT=5
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_INTERNAL_URL=http://localhost:3001/api/v1
# Worker outbox relay tuning — all optional, see apps/worker/src/config/env.ts for defaults
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_MS=500
# Worker log verbosity — optional, defaults to "info"; see apps/worker/src/observability/logger.ts
LOG_LEVEL=info
