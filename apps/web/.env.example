# Server-side base URL: what the Next.js server itself uses (Route
# Handlers, Server Components) to call the API. Under Compose this must be
# the service name and internal port, e.g. http://api:3001/api/v1 — the
# host network's published port is not guaranteed to be reachable from
# inside the containers' own network the same way the service name is.
API_INTERNAL_URL=http://localhost:3001/api/v1

# Browser-side base URL: baked into the client bundle at build time and
# used by every fetch a Client Component makes. Must be an address the
# visitor's own machine can resolve, e.g. the published host port under
# Compose (http://localhost:3001/api/v1). The browser cannot resolve the
# Compose service name "api", so this can never be the same value as
# API_INTERNAL_URL once the app runs in a container.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
